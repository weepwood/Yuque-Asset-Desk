import { LineEdit, ScrollView, AboutSlint } from "std-widgets.slint";

export struct AssetRow {
    name: string,
    detail: string,
    url: string,
    kind: string,
    provider: string,
}

// Native controls: short property transitions, no animation-tick or polling.
component ActionButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> primary: false;
    in property <bool> compact: false;
    callback clicked <=> hit.clicked;

    height: compact ? 33px : 42px;
    min-width: compact ? 80px : 122px;
    border-radius: 10px;
    border-width: 1px;
    border-color: primary ? #5e9bff : (hit.has-hover ? #3e5778 : #2a3c53);
    background: hit.pressed ? (primary ? #2966d4 : #223750)
               : hit.has-hover ? (primary ? #508ff1 : #23364b)
               : (primary ? #377cef : #1a293b);
    animate background, border-color { duration: 140ms; easing: ease-out-quad; }

    Text {
        text: root.label;
        color: #f4f8ff;
        font-size: root.compact ? 12px : 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
    hit := TouchArea { mouse-cursor: pointer; }
}

component NavItem inherits Rectangle {
    in property <string> symbol: "";
    in property <string> label: "";
    in property <bool> selected: false;
    callback clicked <=> hit.clicked;

    height: 46px;
    border-radius: 10px;
    background: selected ? #213d5f : (hit.has-hover ? #1b2b42 : #121f31);
    animate background { duration: 170ms; easing: ease-out-quad; }

    HorizontalLayout {
        padding-left: 13px;
        padding-right: 9px;
        spacing: 12px;
        Text {
            text: root.symbol;
            color: root.selected ? #83bfff : #8a9cb5;
            font-size: 20px;
            width: 23px;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: root.selected ? #f4f8ff : #a1b2c8;
            font-weight: root.selected ? 700 : 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.selected: Rectangle {
            width: 4px;
            height: 19px;
            border-radius: 2px;
            background: #65a5ff;
            
        }
    }
    hit := TouchArea { mouse-cursor: pointer; }
}

component AssetEntry inherits Rectangle {
    in property <AssetRow> asset;
    in property <int> index;
    callback copy-url(int);
    callback copy-markdown(int);

    height: 69px;
    background: hot.has-hover ? #21354b : #172638;
    border-radius: 10px;
    border-width: 1px;
    border-color: hot.has-hover ? #39536e : #243548;
    animate background, border-color { duration: 130ms; easing: ease-out-quad; }

    // Underlay receives row-hover events; action buttons keep their own hit targets.
    hot := TouchArea { mouse-cursor: default; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 12px;
        Rectangle {
            width: 43px;
            height: 43px;
            border-radius: 11px;
            background: root.asset.kind == "image" ? #214c68 : #35445a;
            
            Text {
                width: parent.width;
                height: parent.height;
                horizontal-alignment: center;
                vertical-alignment: center;
                text: root.asset.kind == "image" ? "▧" : "▤";
                color: #acd7ff;
                font-size: 22px;
            }
        }
        VerticalLayout {
            
            horizontal-stretch: 1;
            spacing: 6px;
            Text { text: root.asset.name; color: #edf4ff; font-size: 13px; font-weight: 600; overflow: elide; }
            Text { text: root.asset.detail; color: #8fa6be; font-size: 11px; overflow: elide; }
        }
        ActionButton {
            compact: true;
            label: "复制链接";
            clicked => { root.copy-url(root.index); }
        }
        ActionButton {
            compact: true;
            label: "Markdown";
            clicked => { root.copy-markdown(root.index); }
        }
    }

}

export component MainWindow inherits Window {
    title: "Yuque Asset Desk";
    preferred-width: 1120px;
    preferred-height: 764px;
    min-width: 860px;
    min-height: 610px;
    default-font-size: 13px;
    background: #0b1320;

    in-out property <string> mode-label: "本地演示";
    in-out property <string> status-text: "准备就绪";
    in-out property <string> account-text: "未连接";
    in-out property <string> search-text: "";
    in-out property <[AssetRow]> assets: [];
    in-out property <int> total-count: 0;
    in-out property <int> queue-count: 0;
    in-out property <bool> upload-active: false;
    in-out property <bool> ui-ready: false;

    private property <bool> image-only: false;

    callback pick-files();
    callback copy-url(int);
    callback copy-markdown(int);
    callback hide-main();
    callback show-help();
    callback show-about();
    callback search-changed(string);

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 233px;
            background: #101d2e;
            border-width: 1px;
            border-color: #1e2d42;
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 11px;
                    Rectangle {
                        width: 41px;
                        height: 41px;
                        border-radius: 12px;
                        background: @linear-gradient(125deg, #5a9eff 0%, #2c63ce 100%);
                        Text {
                            text: "Y";
                            color: #ffffff;
                            font-size: 24px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width;
                            height: parent.height;
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        Text { text: "Yuque Desk"; font-size: 16px; font-weight: 700; color: #f1f5ff; }
                        Text { text: "ASSET MANAGER"; font-size: 10px; color: #6d8bae; }
                    }
                }
                Rectangle { height: 28px; background: transparent; }
                Text { text: "工作空间"; color: #607d9b; font-size: 11px; }
                NavItem {
                    label: "上传工作台";
                    symbol: "◫";
                    selected: !root.image-only;
                    clicked => { root.image-only = false; }
                }
                NavItem {
                    label: "图片资源";
                    symbol: "▧";
                    selected: root.image-only;
                    clicked => { root.image-only = true; }
                }
                Rectangle { height: 19px; background: transparent; }
                Text { text: "快捷操作"; color: #607d9b; font-size: 11px; }
                NavItem {
                    label: "选择本地文件";
                    symbol: "＋";
                    clicked => { root.pick-files(); }
                }
                NavItem {
                    label: "隐藏到托盘";
                    symbol: "◉";
                    clicked => { root.hide-main(); }
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Rectangle {
                    height: 112px;
                    background: #172d44;
                    border-color: #264361;
                    border-width: 1px;
                    border-radius: 12px;
                    VerticalLayout {
                        padding: 13px;
                        spacing: 7px;
                        Text { text: "当前存储目标"; font-size: 11px; color: #7f9dbc; }
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle { width: 7px; height: 7px; border-radius: 4px; background: #66caa9;  }
                            Text { text: root.mode-label; color: #e5f2ff; font-weight: 700; overflow: elide; }
                        }
                        Text { text: root.account-text; font-size: 11px; color: #91a9c0; overflow: elide; }
                    }
                }
                ActionButton { label: "使用说明"; clicked => { root.show-help(); } }
                ActionButton { label: "关于应用"; clicked => { root.show-about(); } }
            }
        }
        Rectangle {
            background: #0b1320;
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 27px;
                spacing: 17px;

                HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: 16px;
                    VerticalLayout {
                        spacing: 7px;
                        Text { text: "个人工作区  /  资源上传"; font-size: 11px; color: #7e97b3; }
                        Text { text: "上传与管理"; font-size: 27px; color: #f4f8ff; font-weight: 700; }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Rectangle {
                        height: 34px;
                        width: 141px;
                        background: #183246;
                        border-radius: 17px;
                        border-width: 1px;
                        border-color: #2c5064;
                        
                        HorizontalLayout {
                            padding-left: 12px;
                            spacing: 7px;
                            Rectangle {
                                width: 7px;
                                height: 7px;
                                border-radius: 4px;
                                background: root.upload-active ? #f6c37b : #6ad3a9;
                                animate background { duration: 160ms; easing: ease-out-quad; }
                                
                            }
                            Text {
                                text: root.upload-active ? "正在上传资源" : "桌面服务已就绪";
                                color: #b6dccd;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Rectangle {
                    height: 195px;
                    border-radius: 16px;
                    border-width: 1px;
                    border-color: #345077;
                    background: @linear-gradient(15deg, #14283f 0%, #1b3760 60%, #254c80 100%);
                    opacity: root.ui-ready ? 1.0 : 0.0;
                    animate opacity { duration: 320ms; easing: ease-out-quad; }
                    HorizontalLayout {
                        padding-left: 26px;
                        padding-right: 22px;
                        spacing: 18px;
                        VerticalLayout {
                            spacing: 11px;
                            Rectangle { height: 2px; background: transparent; }
                            Text { text: "UPLOAD CENTER"; color: #99c7ff; font-size: 11px; font-weight: 700; }
                            Text { text: "轻松上传，专注创作"; color: #f7faff; font-size: 24px; font-weight: 700; }
                            Text { text: "上传图片和附件，快速复制可插入文章的 Markdown 链接。"; color: #b7cce8; font-size: 12px; }
                            HorizontalLayout {
                                spacing: 10px;
                                ActionButton {
                                    label: "＋ 选择文件";
                                    primary: true;
                                    clicked => { root.pick-files(); }
                                }
                                Rectangle {
                                    width: 142px;
                                    height: 40px;
                                    border-radius: 10px;
                                    background: #223e5d;
                                    Text {
                                        text: "PNG · JPG · PDF · ZIP";
                                        color: #a6c8f0;
                                        font-size: 10px;
                                        width: parent.width;
                                        height: parent.height;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Rectangle {
                            width: 142px;
                            height: 142px;
                            border-radius: 71px;
                            background: #214673;
                            border-width: 1px;
                            border-color: #4c75a5;
                            
                            Rectangle {
                                x: 16px; y: 16px;
                                width: 110px; height: 110px;
                                border-radius: 55px;
                                background: #2c568d;
                                Text {
                                    text: "↑";
                                    font-size: 65px;
                                    font-weight: 600;
                                    color: #d8eaff;
                                    width: parent.width;
                                    height: parent.height;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        height: 80px;
                        horizontal-stretch: 1;
                        border-radius: 12px;
                        background: #132439;
                        border-width: 1px;
                        border-color: #233950;
                        VerticalLayout {
                            padding: 13px;
                            spacing: 6px;
                            Text { text: "资源总数"; color: #8ca5c2; font-size: 11px; }
                            Text { text: "" + root.total-count; font-size: 24px; color: #f4f8ff; font-weight: 700; }
                        }
                    }
                    Rectangle {
                        height: 80px;
                        horizontal-stretch: 1;
                        border-radius: 12px;
                        background: #132439;
                        border-width: 1px;
                        border-color: #233950;
                        VerticalLayout {
                            padding: 13px;
                            spacing: 6px;
                            Text { text: "待处理队列"; color: #8ca5c2; font-size: 11px; }
                            Text { text: "" + root.queue-count; font-size: 24px; color: root.queue-count > 0 ? #a6caff : #f4f8ff; font-weight: 700; }
                        }
                    }
                    Rectangle {
                        height: 80px;
                        horizontal-stretch: 2;
                        border-radius: 12px;
                        background: #132439;
                        border-width: 1px;
                        border-color: #233950;
                        VerticalLayout {
                            padding: 13px;
                            spacing: 7px;
                            Text { text: "最近操作"; color: #8ca5c2; font-size: 11px; }
                            Text { text: root.status-text; font-size: 12px; color: #b6d8ff; overflow: elide; }
                        }
                    }
                }

                HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: 11px;
                    Text { text: root.image-only ? "图片资源" : "最近上传"; font-size: 18px; color: #e9f2ff; font-weight: 700; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Rectangle {
                        width: 221px;
                        height: 37px;
                        background: #142338;
                        border-radius: 9px;
                        border-color: #253a54;
                        border-width: 1px;
                        LineEdit {
                            x: 9px; y: 2px;
                            width: parent.width - 18px;
                            height: parent.height - 4px;
                            placeholder-text: "搜索资源名称";
                            text <=> root.search-text;
                            edited(text) => { root.search-changed(text); }
                        }
                    }
                    ActionButton {
                        compact: true;
                        label: root.image-only ? "全部资源" : "仅看图片";
                        clicked => { root.image-only = !root.image-only; }
                    }
                }

                Rectangle {
                    background: #111e2e;
                    border-radius: 12px;
                    border-color: #25354a;
                    border-width: 1px;
                    vertical-stretch: 1;
                    ScrollView {
                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;
                            if root.total-count == 0: Rectangle {
                                height: 134px;
                                background: #15263a;
                                border-radius: 10px;
                                VerticalLayout {
                                    padding: 25px;
                                    spacing: 10px;
                                    Text { text: "暂无资源记录"; color: #dbeafa; font-size: 16px; font-weight: 700; horizontal-alignment: center; }
                                    Text { text: "点击上方「选择文件」，开始你的第一次上传"; color: #8ba5be; horizontal-alignment: center; }
                                }
                            }
                            for item[i] in root.assets: AssetEntry {
                                visible: !root.image-only || item.kind == "image";
                                asset: item;
                                index: i;
                                copy-url(index) => { root.copy-url(index); }
                                copy-markdown(index) => { root.copy-markdown(index); }
                            }
                        }
                    }
                }

                Text {
                    text: "本地优先 · 不缓存原始文件 · 演示模式生成的 file:// 链接不能在公开博客使用";
                    color: #69829d;
                    font-size: 11px;
                }
            }
        }
    }
}

export component AppTray inherits SystemTrayIcon {
    icon: @image-url("../assets/tray.png");
    tooltip: "Yuque Asset Desk";
    callback open-main();
    callback quit-app();
    Menu {
        MenuItem { title: "打开上传工作台"; activated => { open-main(); } }
        MenuSeparator { }
        MenuItem { title: "退出 Yuque Asset Desk"; activated => { quit-app(); } }
    }
}

export component AboutWindow inherits Window {
    title: "关于 Yuque Asset Desk";
    preferred-width: 406px;
    preferred-height: 298px;
    background: #142337;
    callback close-about();
    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        Text { text: "Yuque Asset Desk"; color: #f0f7ff; font-size: 21px; font-weight: 700; horizontal-alignment: center; }
        Text { text: "Rust + Slint + SQLite  ·  v0.2.1"; color: #91b5d6; horizontal-alignment: center; }
        AboutSlint { }
        ActionButton { label: "关闭"; clicked => { root.close-about(); } }
    }
}
